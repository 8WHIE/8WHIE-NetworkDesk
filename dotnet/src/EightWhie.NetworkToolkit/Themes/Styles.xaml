<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color Palette -->
    <Color x:Key="BackgroundDark">#0B0F19</Color>
    <Color x:Key="SurfaceDark">#111827</Color>
    <Color x:Key="BorderDark">#1F2937</Color>
    <Color x:Key="TextPrimary">#F9FAFB</Color>
    <Color x:Key="TextSecondary">#9CA3AF</Color>
    <Color x:Key="BrandCyan">#06B6D4</Color>
    <Color x:Key="BrandIndigo">#6366F1</Color>
    <Color x:Key="SuccessGreen">#10B981</Color>
    <Color x:Key="WarningAmber">#F59E0B</Color>
    <Color x:Key="DangerRed">#EF4444</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundDark}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceDark}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderDark}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="BrandCyanBrush" Color="{StaticResource BrandCyan}"/>
    <SolidColorBrush x:Key="BrandIndigoBrush" Color="{StaticResource BrandIndigo}"/>

    <!-- Global Font Style -->
    <Style TargetType="{x:Type Control}" x:Key="DefaultFontStyle">
        <Setter Property="FontFamily" Value="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- Modern Dark Button -->
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource DefaultFontStyle}">
        <Setter Property="Background" Value="{StaticResource BrandIndigoBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern Dark Card Container -->
    <Style TargetType="{x:Type Border}" x:Key="DarkCard">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

</ResourceDictionary>
